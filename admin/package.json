{
  "name": "stickerdock-admin",
  "private": true,
  "version": "0.1.0",
  "description": "StickerDock v2 admin panel (Supabase-backed static SPA, with an offline demo mode).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
