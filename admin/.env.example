# Copy to .env.local (git-ignored) and fill in. Leave the two values empty to run in demo mode.
# Both values are public by design (the browser sees them); access is enforced by RLS + public.admins.
# NEVER put the service-role / secret key here.
VITE_SUPABASE_URL=
# Project Settings -> API: the "anon" key or the newer "publishable" key (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=

# Optional: force demo mode even when the values above are set (e.g. for screenshots).
# VITE_DEMO=true
