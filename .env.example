# Copy to .env (git-ignored) and fill in. StickerDock v2 shares HandNavigate's Supabase project, so the first block
# is the same as the VM's windows-agent/.env — paste those lines unchanged.

# --- Supabase (shared with HandNavigate: https://kyvowdxtwazxhsdjajpm.supabase.co) ---
SUPABASE_URL=https://kyvowdxtwazxhsdjajpm.supabase.co
SUPABASE_SECRET_KEY=            # sb_secret_... (Project Settings → API Keys). Server-side only: worker, migrations.
SUPABASE_DB_HOST=               # Project Settings → Database → Connection string (session pooler host)
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Public key for the phone app's Discover feed and the admin web app (safe to ship in the app).
SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_... (same API Keys page)

# --- Groq (comma-separated; keys of one organization share one quota, so extra keys are failover only) ---
GROQ_API_KEYS=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b

# --- Optional ---
# Token collectors send to the intake Edge Function (only needed when the function is deployed).
INTAKE_TOKEN=
# Supabase personal access token (supabase.com → Account → Access Tokens), only for deploying Edge Functions.
SUPABASE_ACCESS_TOKEN=
# Original sticker art (Cloudflare Workers AI FLUX.1 schnell).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
