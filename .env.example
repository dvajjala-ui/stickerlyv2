# Copy to .env (git-ignored). Never commit real values.

# Supabase (new project for StickerDock v2)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Groq — comma-separated; one organization's keys share one quota (failover only)
GROQ_API_KEYS=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b

# Image intake (HandNavigate and other collectors send this in the x-intake-token header)
INTAKE_TOKEN=

# Optional: original sticker art (Cloudflare Workers AI FLUX.1 schnell, ~170 free images/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Android app Discover feed (public, read-only)
DISCOVER_URL=${SUPABASE_URL}
DISCOVER_ANON_KEY=${SUPABASE_ANON_KEY}
